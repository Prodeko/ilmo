# Environment for the stress stack. Mirrors the production env template in
# infra-prodeko (ansible/roles/ilmo/templates/env.production.j2) minus
# external integrations (SendGrid, Azure storage/translate, Keycloak, OAuth).
NODE_ENV=production
TZ=Europe/Helsinki
ROOT_URL=http://localhost:5678
PORT=5678
GRAPHILE_TURBO=1
NEXT_TRANSLATE_PATH=../client
DATABASE_HOST=db
DATABASE_NAME=ilmo
DATABASE_OWNER=ilmo
DATABASE_OWNER_PASSWORD=stress
DATABASE_AUTHENTICATOR=ilmo_authenticator
DATABASE_AUTHENTICATOR_PASSWORD=stress
DATABASE_VISITOR=ilmo_visitor
DATABASE_URL=postgres://ilmo:stress@db/ilmo
AUTH_DATABASE_URL=postgres://ilmo_authenticator:stress@db/ilmo
ROOT_DATABASE_URL=postgres://postgres:postgres@db/template1
SHADOW_DATABASE_URL=postgres://ilmo:stress@db/ilmo_shadow
REDIS_URL=redis://redis:6379
SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_SECRET=stress-jwt-secret-stress-jwt-secret
PRIVACY_URL=http://localhost:5678/privacy
DATABASE_POOL_MAX_ROOT=2
DATABASE_POOL_MAX_AUTH=5
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=5000
WORKER_POOL_MAX=2
AZURE_DB_OWNER=ilmo
# Required at startup; never called by the registration flow.
AZURE_TRANSLATE_API_URL=http://localhost:9/translate
AZURE_TRANSLATE_SUBSCRIPTION_KEY=stress
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=stress;AccountKey=c3RyZXNz;BlobEndpoint=http://localhost:9/stress;
