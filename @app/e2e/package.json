{
  "name": "@app/e2e",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "cy": "NODE_OPTIONS=\"-r @app/config/env.js\" pnpm exec cypress",
    "open": "pnpm cy open",
    "run:local": "pnpm cy run",
    "run:ci": "pnpm cy run --record --parallel --browser chrome",
    "run:sso": "pnpm cy run --browser chrome --config specPattern=cypress/e2e-sso/**/*.spec.ts",
    "run:sso-live": "pnpm cy run --browser chrome --config specPattern=cypress/e2e-sso-live/**/*.spec.ts,chromeWebSecurity=false",
    "keycloak:up": "docker run -d --name ilmo-keycloak-ci -p 8080:8080 -e KC_BOOTSTRAP_ADMIN_USERNAME=admin -e KC_BOOTSTRAP_ADMIN_PASSWORD=admin -v \"$PWD/keycloak/realm-ci.json:/opt/keycloak/data/import/realm-ci.json:ro\" quay.io/keycloak/keycloak:26.0 start-dev --import-realm",
    "keycloak:down": "docker rm -f ilmo-keycloak-ci",
    "build": "exit 0",
    "watch": "exit 0",
    "dev": "exit 0",
    "depcheck": "depcheck --ignores=\"@app/config,@types/node\""
  },
  "dependencies": {
    "@app/config": "workspace:*"
  },
  "devDependencies": {
    "@cypress/webpack-preprocessor": "^5.12.0",
    "@types/node": "^18.6.5",
    "cypress": "^10.4.0",
    "cypress-file-upload": "^5.0.8",
    "dayjs": "^1.11.4",
    "depcheck": "^1.4.3",
    "slugify": "^1.6.5",
    "webpack": "^5.74.0"
  }
}
