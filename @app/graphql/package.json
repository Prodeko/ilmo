{
  "name": "@app/graphql",
  "private": true,
  "version": "0.0.0",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "pnpm codegen && tsc -b && tsc --project tsconfig.cjs.json",
    "watch": "pnpm codegen --watch",
    "dev": "exit 0",
    "codegen": "graphql-codegen --config codegen.yml",
    "depcheck": "depcheck --ignores=\"@graphql-codegen/*,@urql/*,urql,graphql-tag,graphql-codegen-persisted-query-ids,tslib\""
  },
  "devDependencies": {
    "@graphql-codegen/add": "^5.0.3",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/introspection": "^5.0.2",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-urql": "^5.0.1",
    "@graphql-codegen/typescript-urql-graphcache": "^4.0.2",
    "@graphql-codegen/urql-introspection": "^4.0.1",
    "@urql/introspection": "^1.2.1",
    "graphql-codegen-persisted-query-ids": "^0.2.0"
  }
}
